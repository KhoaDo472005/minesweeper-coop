[Unit]
Description=Do min dong doi (Minesweeper co-op)
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/minesweeper
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=/opt/minesweeper/venv/bin/python server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
